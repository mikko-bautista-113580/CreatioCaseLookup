# Copy to .env and fill in. NEVER commit .env.
# Prefer a dedicated, least-privilege Creatio service account (read-only role).

CREATIO_BASE_URL=https://nelnet.creatio.com

# Sign-in: normally done from Settings → "Log in with Creatio…", which saves
# SSO session cookies here. A service-account login is the alternative:
# CREATIO_LOGIN=your_service_account_login
# CREATIO_PASSWORD=your_service_account_password

# Comma-separated allowlist of OData entity sets this server may read.
# If empty/unset, ALL entities are readable (not recommended). Keep it tight.
# Lookup tab: Case, Activity, SocialMessage, Contact, Account, CaseFile
# (CaseFile is attachment metadata). Lifecycle tab: CaseLifecycle.
CREATIO_ALLOWED_ENTITIES=Case,Activity,SocialMessage,Contact,Account,CaseFile,CaseLifecycle

# Hard cap on rows returned per query (server clamps $top to this).
CREATIO_MAX_TOP=50

# AI model, effort and output style are set in the Settings tab (saved to
# .claude/settings.json: claude-opus-5-5, medium effort, Concise). This is only
# a fallback for when that file sets no model.
# Alternatives: claude-sonnet-5, claude-haiku-4-5-20251001
# CREATIO_APP_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Workspace tab — the local folder(s) you're working in
# ---------------------------------------------------------------------------
# Up to three folders, analyzed TOGETHER as one workspace, by the Workspace tab
# and the workspace-analysis skill. Normally set from the UI rather than here.
# Paths are stored raw (no quotes) — only this app's own parser reads them.
# CREATIO_WORKSPACE_PATH=C:\neldevsrc\Github\MyProject
# CREATIO_WORKSPACE_PATH_2=
# CREATIO_WORKSPACE_PATH_3=

# Total top-level source-file count (across all folders) above which the app
# asks before analyzing, instead of starting a slow run. Default 10.
# CREATIO_WORKSPACE_FILE_CAP=10

# Hard timeout for one workspace analysis, in ms. Default 300000 (5 min).
# CREATIO_WORKSPACE_TIMEOUT_MS=300000

# Hard timeout for one fix-planning run, in ms. Default 600000 (10 min) — longer
# than an analysis because it reads the case, the analysis and the code.
# CREATIO_FIX_TIMEOUT_MS=600000

# The case you're currently working on (Workspace tab, phase 1). Set from the UI
# or with `.venv\Scripts\python -m creatio_case_lookup.workspace_cli case SR00031980`. The fetched description and
# conversation are stored under .analysis/cases/, so the creatio-case-fix skill
# starts with the case in hand instead of asking for it again.
# CREATIO_WORKSPACE_CASE=SR00031980
