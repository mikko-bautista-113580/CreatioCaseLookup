# Copy to .env and fill in. NEVER commit .env.
# Prefer a dedicated, least-privilege Creatio service account (read-only role).

CREATIO_BASE_URL=https://nelnet.creatio.com
CREATIO_LOGIN=your_service_account_login
CREATIO_PASSWORD=your_service_account_password

# Comma-separated allowlist of OData entity sets this server may read.
# If empty/unset, ALL entities are readable (not recommended). Keep it tight.
# Examples: Case, Contact, Account
CREATIO_ALLOWED_ENTITIES=Case

# Hard cap on rows returned per query (server clamps $top to this).
CREATIO_MAX_TOP=50
