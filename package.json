{
  "name": "creatio-mcp-readonly",
  "version": "0.1.0",
  "private": true,
  "description": "Locked-down, read-only MCP server for a Creatio instance (OData 4, forms auth).",
  "type": "module",
  "bin": {
    "creatio-mcp-readonly": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "app": "tsc && node dist/server.js",
    "test-auth": "tsc && node --env-file=.env dist/test-auth.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
